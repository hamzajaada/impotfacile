# Copiez ce fichier en .env et remplissez les valeurs (ne jamais committer .env)

# --- Base de donnees MySQL ---
MYSQL_DATABASE=impotfacile
MYSQL_USER=impotfacile
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Port HTTP du frontend ---
HTTP_PORT=80

# --- JWT : au moins 32 caracteres, c'est le secret qui signe les tokens ---
JWT_SECRET=change-me-with-a-32-char-min-random-secret

# --- Cle de chiffrement AES-256 en base64 (32 octets). Generez-en une :
#     Linux:   openssl rand -base64 32
#     Windows: [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Max 256}) -as [byte[]])
# IMPORTANT : ne la changez jamais apres avoir deploye (les donnees ne seraient plus lisibles).
APP_ENCRYPTION_KEY=

# --- Origines CORS autorisees pour l'API (separees par des virgules) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3001
