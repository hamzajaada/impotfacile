# Backend Node ImpotFacile — copiez ce fichier en .env (dans backend_node/)
# IMPORTANT : JWT_SECRET et APP_ENCRYPTION_KEY doivent etre IDENTIQUES a ceux
#            configures dans le backend Spring (meme base de donnees).

# Port HTTP (sur cPanel, l'application Node recois PORT automatiquement)
PORT=8080

# --- Base de donnees MySQL (meme base que le backend Spring) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=impotfacile

# --- JWT : >= 32 caracteres, meme secret que le backend Spring ---
JWT_SECRET=

# --- Cle AES-256 en base64 (32 octets) : meme cle que APP_ENCRYPTION_KEY du backend Spring ---
APP_ENCRYPTION_KEY=

# --- Origines CORS autorisees (separees par des virgules) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
